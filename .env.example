# Postgres. On Railway, reference the Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@host:5432/db

# Public base URL of the deployed app (no trailing slash)
APP_URL=https://your-app.up.railway.app

# Session cookie signing + token encryption (generate: openssl rand -base64 48)
SESSION_SECRET=
# 32-byte key, base64 (openssl rand -base64 32). Encrypts GHL tokens at rest.
TOKEN_ENCRYPTION_KEY=

# GoHighLevel Marketplace app
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://your-app.up.railway.app/api/ghl/callback
# Optional overrides (defaults shown)
# GHL_API_BASE=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
# GHL_AUTH_BASE=https://marketplace.gohighlevel.com

# Marketplace webhook public keys: paste from the GHL Webhook Integration Guide (PEM).
GHL_WEBHOOK_ED25519_PUBLIC_KEY=
GHL_WEBHOOK_RSA_PUBLIC_KEY=

# Shared secret for the "Email Events" workflow webhook action and other custom webhooks
WEBHOOK_SECRET=

# Background jobs run inside the app (token refresh every 6h, GHL reconcile 07:17 UTC).
# Set DISABLE_CRON=true on PR previews or if you ever run more than one replica.
# DISABLE_CRON=
# Lets you trigger the jobs by hand: curl -H "Authorization: Bearer $CRON_SECRET" $APP_URL/api/cron/nightly
CRON_SECRET=

# Login emails + alert emails (Resend). Without it, magic links are printed to the server log in dev.
RESEND_API_KEY=
EMAIL_FROM=Email Revenue <alerts@yourdomain.com>

# Comma-separated emails allowed to sign in as admins (can see every location)
ADMIN_EMAILS=you@yourdomain.com

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
